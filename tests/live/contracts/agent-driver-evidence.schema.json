{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex-live-agent-driver-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenario", "disposition", "run_id", "daemon_id", "checkpoint_before", "checkpoint_after", "exact_fixture_ids", "expected_action", "observed_state", "observation_sequence", "surface_artifacts", "cleanup_evidence"],
  "properties": {
    "schema": {"const": "cortex-live-agent-driver-evidence-v1"},
    "scenario": {"type": "string", "minLength": 1},
    "disposition": {"const": "pass"},
    "run_id": {"type": "string", "pattern": "^cortex-e2e-"},
    "daemon_id": {"type": "string", "minLength": 1},
    "checkpoint_before": {"type": "string", "minLength": 1},
    "checkpoint_after": {"type": "string", "minLength": 1},
    "exact_fixture_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "expected_action": {"type": "string", "minLength": 1},
    "observed_state": {"type": "string", "minLength": 1},
    "observation_sequence": {"type": "integer", "minimum": 1},
    "surface_artifacts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
    "cleanup_evidence": {"const": "canonical-resource-manifest"}
  }
}
