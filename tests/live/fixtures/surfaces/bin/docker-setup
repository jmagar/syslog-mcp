#!/bin/sh
# Setup's external Docker dependency double. The setup command still writes and
# validates every run-owned filesystem asset; the real Compose lifecycle is
# independently exercised by the compose surfaces in the same phase.
# The candidate is always built from this checkout, so report this checkout's
# version: a hard-coded string goes stale on every release bump and turns the
# runtime-current check into a false STALE. Resolve symlinks first, since the
# setup lane reaches this script through a link in its run-owned bin dir.
candidate_version() {
  awk -F'"' '/^version = / {print $2; exit}' \
    "$(cd "$(dirname "$(readlink -f "$0")")/../../../../.." && pwd)/Cargo.toml"
}
case "$*" in
  *'compose ps -q'*) printf '%s\n' surface-setup-cortex ;;
  *'compose config --images'*) printf '%s\n' cortex:local-debug ;;
  *'inspect '*'project.working_dir'*) printf '%s\n' "${HOME:?}/.cortex/compose" ;;
  *'inspect '*'Config.Image'*) printf '%s\n' cortex:local-debug ;;
  *'inspect '*'{{.Image}}'*) printf '%s\n' sha256:surface-setup ;;
  *'image inspect '*'{{.Id}}'*) printf '%s\n' sha256:surface-setup ;;
  *'image inspect '*'RepoDigests'*) printf '%s\n' '' ;;
  *'exec '*'cortex --version'*) printf 'cortex %s\n' "$(candidate_version)" ;;
  *version*) printf '%s\n' 'Docker Compose version v5.1.2' ;;
esac
exit 0
